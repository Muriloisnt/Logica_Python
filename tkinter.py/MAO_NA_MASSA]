import tkinter as tk


def calcular_imc():
  try:
    
    peso = float(entrada_peso.get().replace(",", "."))
    altura = float(entrada_altura.get().replace(",", "."))

    
    imc = peso / (altura**2)

   
    if imc < 18.5:
      mensagem = "Abaixo do peso"
    elif imc < 25:
      mensagem = "Saudável"
    elif imc < 30:
      mensagem = "Sobrepeso"
    else:
      mensagem = "Obesidade"

    label_resultado.config(text=f"IMC: {imc:.2f}\nStatus: {mensagem}")

  except ValueError:
    
    label_resultado.config(text="Erro: Digite apenas números!")



janela = tk.Tk()
janela.title("Calculadora de IMC")
janela.geometry("250x250")


label_peso = tk.Label(janela, text="Peso (kg):")
label_peso.pack(pady=5)
entrada_peso = tk.Entry(janela)
entrada_peso.pack(pady=5)


label_altura = tk.Label(janela, text="Altura (M):")
label_altura.pack(pady=5)
entrada_altura = tk.Entry(janela)
entrada_altura.pack(pady=5)


botao_calcular = tk.Button(janela, text="Calcular IMC", command=calcular_imc)
botao_calcular.pack(pady=15)


label_resultado = tk.Label(janela, text="", font=("Arial", 10, "bold"))
label_resultado.pack(pady=5)


janela.mainloop()
