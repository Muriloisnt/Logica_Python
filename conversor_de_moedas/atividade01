import tkinter as tk
from tkinter import ttk, messagebox

# Taxas de exemplo em relação ao Real (BRL)
TAXAS = {
    "BRL": 1.00,
    "USD": 0.1967,
    "EUR": 0.1680,
    "GBP": 0.1450,
    "JPY": 28.00,
}


def converter():
    try:
        valor = float(entrada_valor.get().replace(",", "."))

        if valor <= 0:
            messagebox.showerror(
                "Erro",
                "Digite um valor maior que zero."
            )
            return

        origem = moeda_origem.get()
        destino = moeda_destino.get()

        # Converte primeiro para BRL
        valor_em_brl = valor / TAXAS[origem]

        # Depois converte de BRL para a moeda destino
        resultado = valor_em_brl * TAXAS[destino]

        simbolos = {
            "BRL": "R$",
            "USD": "$",
            "EUR": "€",
            "GBP": "£",
            "JPY": "¥"
        }

        resultado_label.config(
            text=f"{simbolos[destino]} {resultado:,.2f} {destino}"
        )

        # Resposta ao clicar em CONVERTER
        messagebox.showinfo(
            "Conversão realizada",
            f"{valor:.2f} {origem} = "
            f"{simbolos[destino]} {resultado:,.2f} {destino}"
        )

    except ValueError:
        messagebox.showerror(
            "Erro",
            "Digite um valor numérico válido."
        )


# Janela principal
janela = tk.Tk()
janela.title("Conversor de Moedas")
janela.geometry("400x450")
janela.resizable(False, False)
janela.configure(bg="#f2f4f7")


# Título
titulo = tk.Label(
    janela,
    text="Conversor de Moedas",
    font=("Arial", 22, "bold"),
    bg="#f2f4f7",
    fg="#1f2937"
)
titulo.pack(pady=(30, 25))


# Frame principal
frame = tk.Frame(
    janela,
    bg="white",
    padx=25,
    pady=25
)
frame.pack(padx=25, fill="both")


# Valor
tk.Label(
    frame,
    text="Valor:",
    font=("Arial", 12, "bold"),
    bg="white",
    fg="#374151"
).pack(anchor="w")

entrada_valor = tk.Entry(
    frame,
    font=("Arial", 14),
    width=25,
    bd=1,
    relief="solid"
)
entrada_valor.pack(pady=(5, 20), ipady=7)


# Moeda de origem
tk.Label(
    frame,
    text="Moeda de origem:",
    font=("Arial", 12, "bold"),
    bg="white",
    fg="#374151"
).pack(anchor="w")

moeda_origem = ttk.Combobox(
    frame,
    values=list(TAXAS.keys()),
    state="readonly",
    font=("Arial", 12),
    width=23
)
moeda_origem.set("BRL")
moeda_origem.pack(pady=(5, 20), ipady=4)


# Moeda de destino
tk.Label(
    frame,
    text="Moeda de destino:",
    font=("Arial", 12, "bold"),
    bg="white",
    fg="#374151"
).pack(anchor="w")

moeda_destino = ttk.Combobox(
    frame,
    values=list(TAXAS.keys()),
    state="readonly",
    font=("Arial", 12),
    width=23
)
moeda_destino.set("USD")
moeda_destino.pack(pady=(5, 25), ipady=4)


# Botão
botao_converter = tk.Button(
    frame,
    text="CONVERTER",
    command=converter,
    font=("Arial", 12, "bold"),
    bg="#2563eb",
    fg="white",
    activebackground="#1d4ed8",
    activeforeground="white",
    cursor="hand2",
    bd=0,
    padx=20,
    pady=10
)
botao_converter.pack()


# Resultado
resultado_label = tk.Label(
    janela,
    text="Resultado",
    font=("Arial", 20, "bold"),
    bg="#f2f4f7",
    fg="#16a34a"
)
resultado_label.pack(pady=30)


janela.mainloop()

