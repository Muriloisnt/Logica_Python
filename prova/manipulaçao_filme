def main():

    print("Digite nomes de usuários (pressione Enter em branco para terminar):")

    nomes = []

    while True:

        nome = input("Digite o nome: ").strip()

        if nome == "":
            break

        nomes.append(nome)

    if not nomes:

        print("Nenhum nome fornecido. Saindo.")

        return

    arquivo = "nomes.txt"

    with open(arquivo, "w", encoding="utf-8") as f:

        for n in nomes:

            f.write(n + "\n")

    print(f"Escrito {len(nomes)} nomes em '{arquivo}'.")
    print("Conteúdo final:")

    with open(arquivo, "r", encoding="utf-8") as f:

        conteudo = f.read()

    print(conteudo)


if __name__ == "__main__":

    main()


